{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xverse.io/profiles/assured-aeb/v0.1/schema.json",
  "title": "io.xverse.assured-aeb Profile v0.1 (Phase 8 WP-12)",
  "description": "Blueprint-owned extension of the assured AEB topology: per-Component authority, element placement (shape S-A), flow declarations, and System-level common-cause, freeze-target and degraded-path declarations. Undecided protocol values are TODO strings; no number is a protocol value.",
  "type": "object",
  "required": ["schemaVersion", "kind"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "kind": {"enum": ["component-authority", "unit-host", "element-placement", "flow-declaration", "system-architecture", "scenario-evaluation"]}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "component-authority"}}},
     "then": {"required": ["authorityClass", "permittedOutputs"],
              "properties": {"schemaVersion": true, "kind": true,
                             "authorityClass": {"$ref": "#/$defs/authorityClass"},
                             "permittedOutputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}},
              "additionalProperties": false}},
    {"if": {"properties": {"kind": {"const": "unit-host"}}},
     "then": {"required": ["unitClass", "hostedElements"],
              "properties": {"schemaVersion": true, "kind": true,
                             "unitClass": {"enum": ["environment", "experiment-control", "runtime"]},
                             "hostedElements": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}},
              "additionalProperties": false}},
    {"if": {"properties": {"kind": {"const": "element-placement"}}},
     "then": {"required": ["hostUnit", "arms", "computeLatency"],
              "properties": {"schemaVersion": true, "kind": true,
                             "hostUnit": {"$ref": "#/$defs/identifier"},
                             "arms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/arm"}},
                             "computeLatency": {"$ref": "#/$defs/todo"}},
              "additionalProperties": false}},
    {"if": {"properties": {"kind": {"const": "flow-declaration"}}},
     "then": {"required": ["intraUnit", "latencyKind", "modelledLatency", "freshness", "deadline", "faultAdmission"],
              "properties": {"schemaVersion": true, "kind": true,
                             "intraUnit": {"type": "boolean"},
                             "latencyKind": {"enum": ["none", "actuation", "sensor-sampling", "network", "compute-and-network"]},
                             "modelledLatency": {"oneOf": [{"const": "none"}, {"$ref": "#/$defs/todo"}]},
                             "freshness": {"$ref": "#/$defs/todo"},
                             "deadline": {"$ref": "#/$defs/todo"},
                             "faultAdmission": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                             "ablationException": {"$ref": "#/$defs/arm"},
                             "hubDelay": {"type": "object", "required": ["unit", "value"],
                                          "properties": {"unit": {"const": "simulator-step"}, "value": {"const": 1}},
                                          "additionalProperties": false}},
              "additionalProperties": false}},
    {"if": {"properties": {"kind": {"const": "system-architecture"}}},
     "then": {"required": ["arm", "commonCause", "freezeTargets", "degradedPath", "intraUnitMessages", "returnFlows", "excluded"],
              "properties": {"schemaVersion": true, "kind": true,
                             "arm": {"type": "string", "minLength": 1},
                             "commonCause": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "members", "exercise"],
                                             "properties": {"id": {"$ref": "#/$defs/identifier"}, "kind": {"type": "string"},
                                                            "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}},
                                                            "exercise": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
                             "freezeTargets": {"type": "object", "required": ["admitted", "admittedSets", "refused", "refusedKinds", "rule"]},
                             "degradedPath": {"type": "object", "required": ["configuration", "dependencies", "notDependencies"]},
                             "intraUnitMessages": {"type": "array", "items": {"type": "object", "required": ["source", "destination", "interfaceId"],
                                                   "properties": {"source": {"$ref": "#/$defs/identifier"},
                                                                  "destination": {"$ref": "#/$defs/identifier"},
                                                                  "interfaceId": {"$ref": "#/$defs/identifier"}},
                                                   "additionalProperties": false}},
                             "form": {"enum": ["topology", "maestro"]},
                             "unplannedFlows": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
                             "returnFlows": {"type": "array", "items": {"type": "object", "required": ["id", "source", "destination", "interfaceId", "networkId", "declaration"],
                                             "properties": {"id": {"$ref": "#/$defs/identifier"}, "source": {"$ref": "#/$defs/identifier"},
                                                            "destination": {"$ref": "#/$defs/identifier"}, "interfaceId": {"$ref": "#/$defs/identifier"},
                                                            "networkId": {"$ref": "#/$defs/identifier"}, "declaration": {"type": "object"}},
                                             "additionalProperties": false}},
                             "excluded": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
              "additionalProperties": false}}
    ,{"if": {"properties": {"kind": {"const": "scenario-evaluation"}}},
     "then": {"required": ["form", "evaluationObservers", "offlineMetrics"],
              "properties": {"schemaVersion": true, "kind": true, "form": {"enum": ["topology", "maestro"]},
                             "evaluationObservers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
                             "offlineMetrics": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "calculationRef", "acceptance"],
                                                "properties": {"id": {"$ref": "#/$defs/identifier"}, "calculationRef": {"type": "string"},
                                                               "acceptance": {"$ref": "#/$defs/todo"}}, "additionalProperties": false}}},
              "additionalProperties": false}}
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "minLength": 1, "maxLength": 63},
    "arm": {"enum": ["comparator", "mloc", "authorization-bypass", "verification-bypass", "mloc-7unit"]},
    "todo": {"type": "string", "pattern": "^TODO: (author decision|measurement|engineering verification|design) \\([^)]+\\)$"},
    "authorityClass": {"enum": ["environment", "experiment-control", "sink", "evidence-source", "evidence-router", "productive",
                                "proposer", "goal-interpreter", "assessor", "gate", "executor", "verifier",
                                "fallback-supervisor", "actuation-path", "unit-host"]}
  }
}
